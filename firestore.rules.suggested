// Firestore rules for the attendance app.
// The web app currently writes to the shared attendance_master_data/appData document
// without Firebase auth, so the document must be writable until the app is migrated
// to an authenticated security model.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Main app data document used by the attendance app.
    match /attendance_master_data/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Keep the rest of the database locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
